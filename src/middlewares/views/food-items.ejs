<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head.ejs') %>
  <title>CalorieCoach - Food Items</title>
</head>
<body>
<%- include('partials/header.ejs') %>

<%
  const metricUnits = {
    calories: "kcal",
    protein: "g",
    carbs: "g",
    fiber: "g",
    sugars: "g",
    fat: "g",
    potassium: "mg",
    sodium: "mg",
    magnesium: "mg",
    iron: "mg",
    zinc: "mg",
    vitamin_b6: "mg",
    vitamin_b12: "µg",
    vitamin_c: "mg",
    vitamin_d: "µg",
  };

  function metricLabel(name) {
    const label = name.replace(/_/g, " ").replace(/\b\w/g, character => character.toUpperCase());
    return metricUnits[name] ? `${label} (${metricUnits[name]})` : label;
  }

  function nutrientValue(food, name) {
    const value = food.foodNutrients?.[name];
    return Number.isFinite(Number(value)) ? Number(value) : null;
  }

  function positiveNumber(value) {
    const number = Number(value);
    return Number.isFinite(number) && number > 0 ? number : null;
  }

  function formatNumber(value) {
    const number = Number(value);
    return Number.isFinite(number) && !Number.isInteger(number)
      ? number.toFixed(2).replace(/(\.\d*?)0+$/, "$1").replace(/\.$/, "")
      : String(number);
  }

  function portionUnit(portion) {
    const measureUnit = portion?.measureUnit;
    if (measureUnit && typeof measureUnit === "object") {
      const name = typeof measureUnit.name === "string" && measureUnit.name.trim()
        ? measureUnit.name.trim()
        : typeof measureUnit.abbreviation === "string" && measureUnit.abbreviation.trim()
          ? measureUnit.abbreviation.trim()
          : "";
      if (name) return name;
    }

    // Keep old records readable while the migration is rolled out.
    if (typeof portion?.unit === "string" && portion.unit.trim()) return portion.unit.trim();
    return "";
  }

  function portionDescription(portion) {
    return [portion?.disseminationText, portion?.portionDescription, portion?.modifier]
      .find(value => typeof value === "string" && value.trim())?.trim() || "";
  }

  function portionLabel(portion) {
    const amount = positiveNumber(portion?.amount);
    const unit = portionUnit(portion);
    if (amount && unit) {
      const embeddedAmount = unit.match(/^(\d+(?:\.\d+)?)\s+(.+)$/);
      return embeddedAmount && Number(embeddedAmount[1]) === amount ? unit : `${formatNumber(amount)} ${unit}`;
    }
    return portionDescription(portion) || unit || "Serving";
  }

  function portionGramWeight(portion) {
    return positiveNumber(portion?.gramWeight) ?? positiveNumber(portion?.grams);
  }

  function formatPortion(portion) {
    const grams = portionGramWeight(portion);
    return `${portionLabel(portion)}`;//${grams ? ` (${formatNumber(grams)} g)` : ""}
  }

  function foodNames(food) {
    const names = Array.isArray(food.names) ? food.names.filter(name => typeof name === "string" && name.trim()) : [];
    return names;
  }

  function primaryFoodName(food) {
    return foodNames(food)[0] || "Unnamed food";
  }

  const allNutrientNames = Array.isArray(nutrientNames) ? nutrientNames : ["calories", "protein", "carbs", "fat"];
  const columnCount = allNutrientNames.length + 5;
%>

<div class="container-fluid py-5">
  <div class="justify-content-between align-items-center mb-3">
    <h1 class="mb-2 text-center">Food Items</h1>
    <p class="text-center text-muted mb-4">Each nutrient value is for the listed serving size.</p>
    <div class="d-flex gap-2 food-buttons">
      <input
        type="text"
        id="foodSearch"
        class="form-control"
        placeholder="Search any field..."
      />
      <button class="btn btn-outline-danger" id="deleteSelectedBtn" disabled style="min-width: fit-content;">
        <i class="fa fa-trash"></i> Delete selected
      </button>
      <button class="btn btn-success" id="addFoodBtn" style="min-width: fit-content;">
        <i class="fa fa-plus"></i> Add
      </button>
    </div>
  </div>

  <div style="overflow-x: auto;">
    <table class="table table-striped table-hover align-middle food-database-table">
      <thead>
        <tr>
          <th>
            <input class="form-check-input" type="checkbox" id="selectAllFoods" aria-label="Select all visible food items" />
          </th>
          <th aria-label="Actions"></th>
          <th>Name</th>
          
          <th>Serving size</th>
          <th>Source</th>
     
          <!-- <% allNutrientNames.forEach(name => { %>
            <th><%= metricLabel(name) %></th>
          <% }) %> -->

       
        </tr>
      </thead>
      <tbody id="db_body">
        <% if (foods.length === 0) { %>
          <tr data-empty-state>
            <td colspan="<%= columnCount %>" class="text-center text-muted">No food items yet</td>
          </tr>
        <% } %>
        <% for (let i = foods.length - 1; i >= 0; i--) {
          const food = foods[i];
          const rowFood = {
            names: foodNames(food),
            foodPortions: food.foodPortions ?? [],
            source: food.source ?? "",
            sourceId: food.sourceId ?? "",
            foodNutrients: food.foodNutrients ?? {},
          };
        %>
          <tr data-id="<%= food._id %>" data-food="<%= JSON.stringify(rowFood) %>">
            <td>
              <input
                class="form-check-input food-select"
                type="checkbox"
                value="<%= food._id %>"
                aria-label="Select <%= primaryFoodName(food) %>"
              />
            </td>
             <td>
              <button class="btn btn-sm btn-primary edit-btn" aria-label="Edit <%= primaryFoodName(food) %>">
                <i class="fa fa-edit"></i>
              </button>
            </td>
            <td class="food-name-cell"><%= foodNames(food).join(" · ") %></td>

           
            <td><%= (food.foodPortions ?? []).map(formatPortion).join(" · ") || "—" %></td>
            <td class="food-source-cell"><%= food.source || "—" %></td>
  
            <!-- <% allNutrientNames.forEach(name => {
              const value = nutrientValue(food, name);
            %>
              <td><%= value === null ? "—" : value %></td>
            <% }) %> -->

          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="foodModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <form id="foodForm" class="modal-content">
      <input type="hidden" id="foodId">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Add Food</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="food-entry-edit">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label mb-0">Food names</label>
              <button class="btn btn-sm btn-outline-primary" type="button" id="addFoodNameBtn">Add name</button>
            </div>
            <div id="foodNames" class="vstack gap-2"></div>
            <small class="text-muted">The first name is displayed first; every name is searchable.</small>
          </div>
          <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label mb-0">Food portions</label>
              <button class="btn btn-sm btn-outline-primary" type="button" id="addFoodPortionBtn">Add portion</button>
            </div>
            <div class="d-flex small text-muted fw-semibold" aria-hidden="true">
              <span class="flex-fill">Amount</span>
              <span class="flex-fill">Measure unit</span>
              <span class="flex-fill">Gram weight</span>
              <span style="width: 5rem;">Actions</span>
            </div>
            <div id="foodPortions" class="vstack gap-2"></div>
            <small class="text-muted">Drag portions into order. The top portion is saved with the lowest rank.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="foodSource">Source</label>
            <input id="foodSource" class="form-control" placeholder="e.g. USDA FoodData Central" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="foodSourceId">Source ID</label>
            <input id="foodSourceId" class="form-control" placeholder="e.g. FDC ID or barcode" />
          </div>
        </div>

        <div class="border-top mt-4 pt-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <h6 class="mb-0">Nutrition per serving</h6>
              <small class="text-muted">Clear a value to remove that nutrient from this food.</small>
            </div>
          </div>
          <div id="nutritionFields" class="row g-3"></div>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between">
        <button class="btn btn-danger" id="deleteFoodBtn" style="display:none;">
          <i class="fa fa-trash"></i> Delete
        </button>
        <div>
          <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Save</button>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const defaultNutrientNames = <%- JSON.stringify(allNutrientNames).replace(/</g, "\\u003c") %>;
  const modal = new bootstrap.Modal(document.getElementById("foodModal"));
  const form = document.getElementById("foodForm");
  const nutritionFields = document.getElementById("nutritionFields");

  const foodId = document.getElementById("foodId");
  const foodNamesContainer = document.getElementById("foodNames");
  const addFoodNameBtn = document.getElementById("addFoodNameBtn");
  const foodPortionsContainer = document.getElementById("foodPortions");
  const addFoodPortionBtn = document.getElementById("addFoodPortionBtn");
  let draggedFoodPortionRow = null;
  const sourceInput = document.getElementById("foodSource");
  const sourceIdInput = document.getElementById("foodSourceId");
  const modalTitle = document.getElementById("modalTitle");
  const searchInput = document.getElementById("foodSearch");
  const deleteBtn = document.getElementById("deleteFoodBtn");
  const selectAllFoods = document.getElementById("selectAllFoods");
  const deleteSelectedBtn = document.getElementById("deleteSelectedBtn");
  const metricUnits = {
    calories: "kcal", protein: "g", carbs: "g", fiber: "g", sugars: "g", fat: "g",
    potassium: "mg", sodium: "mg", magnesium: "mg", iron: "mg", zinc: "mg",
    vitamin_b6: "mg", vitamin_b12: "µg", vitamin_c: "mg", vitamin_d: "µg",
  };

  function labelForMetric(name) {
    const label = name.replace(/_/g, " ").replace(/\b\w/g, character => character.toUpperCase());
    return metricUnits[name] ? `${label} (${metricUnits[name]})` : label;
  }

  function createNutrientField(name = "", value = "", lockedName = false) {
    const row = document.createElement("div");
    row.className = "col-md-6 nutrient-field";

    const nameLabel = document.createElement("label");
    nameLabel.className = "form-label";
    nameLabel.textContent = lockedName ? labelForMetric(name) : "Nutrient name";

   const nameInput = document.createElement("input");
    nameInput.type = "text";
    nameInput.style.display= "none";
    nameInput.className = "form-control mb-2";
    nameInput.dataset.metricName = "true";
    nameInput.value = name;
    nameInput.placeholder = "e.g. saturated_fat";
    nameInput.setAttribute("aria-label", lockedName ? `${labelForMetric(name)} nutrient name` : "Nutrient name");
    nameInput.readOnly = lockedName;

    // const valueLabel = document.createElement("label");
    // valueLabel.className = "form-label";
    // valueLabel.textContent = lockedName ? "Value" : "Nutrient value";

    const valueInput = document.createElement("input");
    valueInput.type = "number";
    valueInput.step = "any";
    valueInput.className = "form-control";
    valueInput.dataset.metricValue = "true";
    valueInput.value = value === undefined || value === null ? "" : String(value);
    valueInput.setAttribute("aria-label", `${name || "Custom nutrient"} value`);
    if (name === "calories") valueInput.required = true;

    row.append(nameInput, nameLabel, valueInput);

    if (!lockedName) {
      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "btn btn-sm btn-link text-danger px-0 mt-1";
      removeButton.textContent = "Remove nutrient";
      removeButton.addEventListener("click", () => row.remove());
      row.append(removeButton);
    }

    nutritionFields.append(row);
  }

  function renderNutrition(foodNutrients = {}) {
    nutritionFields.replaceChildren();
    const names = [...new Set([...defaultNutrientNames, ...Object.keys(foodNutrients)])];
    names.forEach(name => createNutrientField(name, foodNutrients[name], true));
  }

  function positiveNumber(value) {
    const number = Number(value);
    return Number.isFinite(number) && number > 0 ? number : null;
  }

  function portionUnit(portion = {}) {
    const measureUnit = portion.measureUnit;
    if (measureUnit && typeof measureUnit === "object") {
      const name = typeof measureUnit.name === "string" && measureUnit.name.trim()
        ? measureUnit.name.trim()
        : typeof measureUnit.abbreviation === "string" && measureUnit.abbreviation.trim()
          ? measureUnit.abbreviation.trim()
          : "";
      if (name) return name;
    }

    if (typeof portion.unit === "string" && portion.unit.trim()) {
      return portion.unit.trim().replace(/^\d+(?:\.\d+)?\s+/, "");
    }

    const description = [portion.disseminationText, portion.portionDescription, portion.modifier]
      .find(value => typeof value === "string" && value.trim())?.trim() || "";
    // The editor has separate amount and unit fields, so remove a quantity
    // embedded in descriptions such as "1 serving".
    return description.replace(/^\d+(?:\.\d+)?\s+/, "");
  }

  function portionAmount(portion = {}) {
    const amount = positiveNumber(portion.amount);
    if (amount) return amount;

    const legacyUnit = typeof portion.unit === "string" ? portion.unit.trim() : "";
    const match = legacyUnit.match(/^(\d+(?:\.\d+)?)\s+/);
    if (match) return Number(match[1]);

    const description = [portion.disseminationText, portion.portionDescription, portion.modifier]
      .find(value => typeof value === "string" && value.trim())?.trim() || "";
    const descriptionAmount = description.match(/^(\d+(?:\.\d+)?)\s+/);
    return descriptionAmount ? Number(descriptionAmount[1]) : 1;
  }

  function portionGramWeight(portion = {}) {
    return positiveNumber(portion.gramWeight) ?? positiveNumber(portion.grams) ?? "";
  }

  function addFoodPortion(portion = {}) {
    const row = document.createElement("div");
    row.className = "input-group";
    row.dataset.foodPortionRow = "true";

    const amount = document.createElement("input");
    amount.type = "number";
    amount.className = "form-control";
    amount.placeholder = "Amount";
    amount.value = portionAmount(portion);
    amount.min = "0.000001";
    amount.step = "any";
    amount.required = true;
    amount.dataset.foodPortionAmount = "true";

    const unit = document.createElement("input");
    unit.type = "text";
    unit.className = "form-control";
    unit.placeholder = "Measure (e.g. cup)";
    unit.value = portionUnit(portion);
    unit.required = true;
    unit.maxLength = 160;
    unit.dataset.foodPortionUnit = "true";

    const grams = document.createElement("input");
    grams.type = "number";
    grams.className = "form-control";
    grams.placeholder = "Gram weight";
    grams.value = portionGramWeight(portion);
    grams.min = "0.000001";
    grams.step = "any";
    grams.required = true;
    grams.dataset.foodPortionGrams = "true";

    const dragHandle = document.createElement("button");
    dragHandle.type = "button";
    dragHandle.className = "btn btn-outline-secondary";
    dragHandle.setAttribute("aria-label", "Drag to reorder food portion");
    dragHandle.setAttribute("title", "Drag to reorder");
    dragHandle.draggable = true;
    dragHandle.innerHTML = '<i class="fa fa-bars"></i>';
    dragHandle.addEventListener("dragstart", event => {
      draggedFoodPortionRow = row;
      event.dataTransfer.effectAllowed = "move";
      event.dataTransfer.setData("text/plain", "food-portion");
      row.classList.add("opacity-50");
    });
    dragHandle.addEventListener("dragend", () => {
      draggedFoodPortionRow?.classList.remove("opacity-50");
      draggedFoodPortionRow = null;
    });

    row.addEventListener("dragover", event => {
      event.preventDefault();
      if (!draggedFoodPortionRow || draggedFoodPortionRow === row) return;

      const midpoint = row.getBoundingClientRect().top + row.offsetHeight / 2;
      foodPortionsContainer.insertBefore(
        draggedFoodPortionRow,
        event.clientY < midpoint ? row : row.nextElementSibling,
      );
    });

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.className = "btn btn-outline-danger";
    removeButton.setAttribute("aria-label", "Remove food portion");
    removeButton.innerHTML = '<i class="fa fa-trash"></i>';
    removeButton.addEventListener("click", () => {
      if (foodPortionsContainer.querySelectorAll("[data-food-portion-row]").length <= 1) return;
      row.remove();
      updateFoodPortionControls();
    });

    row.append(amount, unit, grams, dragHandle, removeButton);
    foodPortionsContainer.append(row);
    updateFoodPortionControls();
  }

  function updateFoodPortionControls() {
    const rows = [...foodPortionsContainer.querySelectorAll("[data-food-portion-row]")];
    rows.forEach(row => {
      row.querySelector('[aria-label="Remove food portion"]').disabled = rows.length === 1;
    });
  }

  function renderFoodPortions(portions = []) {
    foodPortionsContainer.replaceChildren();
    const suppliedPortions = Array.isArray(portions) ? portions : [];
    (suppliedPortions.length ? suppliedPortions : [{}]).forEach(portion => addFoodPortion(portion));
  }

  function collectFoodPortions() {
    const portions = [...foodPortionsContainer.querySelectorAll("[data-food-portion-row]")].map((row, index) => {
      const amount = Number(row.querySelector("[data-food-portion-amount]").value);
      const unit = row.querySelector("[data-food-portion-unit]").value.trim().replace(/\s+/g, " ");
      const grams = Number(row.querySelector("[data-food-portion-grams]").value);
      if (!Number.isFinite(amount) || amount <= 0 || !unit || !Number.isFinite(grams) || grams <= 0) {
        throw new Error("Every food portion needs a positive amount, a measure unit, and a positive gram weight.");
      }
      // The food API accepts this compact edit shape and persists it as the
      // canonical USDA-style { amount, measureUnit, gramWeight, rank } format.
      return { unit: `${amount} ${unit}`, grams, rank: index + 1 };
    });

    if (portions.length === 0) throw new Error("Add at least one food portion.");
    return portions;
  }

  function updateFoodNameRemoveButtons() {
    const rows = [...foodNamesContainer.querySelectorAll("[data-food-name-row]")];
    rows.forEach(row => {
      const removeButton = row.querySelector("[data-remove-food-name]");
      removeButton.disabled = rows.length === 1;
    });
  }

  function addFoodName(value = "") {
    const row = document.createElement("div");
    row.className = "input-group";
    row.dataset.foodNameRow = "true";

    const input = document.createElement("input");
    input.type = "text";
    input.className = "form-control";
    input.dataset.foodName = "true";
    input.value = value;
    input.required = true;
    input.maxLength = 160;
    input.placeholder = "e.g. Jamba Peach Perfection";
    input.setAttribute("aria-label", "Food name");

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.className = "btn btn-outline-danger";
    removeButton.dataset.removeFoodName = "true";
    removeButton.innerHTML = '<i class="fa fa-trash"></i>';
    removeButton.setAttribute("aria-label", "Remove food name");
    removeButton.addEventListener("click", () => {
      if (foodNamesContainer.querySelectorAll("[data-food-name-row]").length <= 1) return;
      row.remove();
      updateFoodNameRemoveButtons();
    });

    row.append(input, removeButton);
    foodNamesContainer.append(row);
    updateFoodNameRemoveButtons();
    return input;
  }

  function renderFoodNames(names = []) {
    foodNamesContainer.replaceChildren();
    const suppliedNames = Array.isArray(names) ? names : [];
    (suppliedNames.length > 0 ? suppliedNames : [""]).forEach(name => addFoodName(name));
  }

  function collectFoodNames() {
    const names = [...foodNamesContainer.querySelectorAll("[data-food-name]")]
      .map(input => input.value.trim().replace(/\s+/g, " "));
    if (names.some(name => !name)) throw new Error("Every food name must contain text.");
    const uniqueNames = [...new Map(names.map(name => [name.toLowerCase(), name])).values()];
    if (uniqueNames.length === 0) throw new Error("Add at least one food name.");
    return uniqueNames;
  }

  function openEditor(food = {}) {
    form.reset();
    foodId.value = food.id || "";
    renderFoodNames(food.names || []);
    renderFoodPortions(food.foodPortions || []);
    sourceInput.value = food.source || "";
    sourceIdInput.value = food.sourceId || "";
    renderNutrition(food.foodNutrients || {});
  }

  function collectFoodNutrients() {
    const foodNutrients = {};
    const fields = nutritionFields.querySelectorAll(".nutrient-field");

    for (const field of fields) {
      const name = field.querySelector("[data-metric-name]").value.trim();
      const value = field.querySelector("[data-metric-value]").value.trim();
      if (!name && !value) continue;
      if (!name) throw new Error("Every nutrient value needs a nutrient name.");
      if (!value) continue;

      const number = Number(value);
      if (!Number.isFinite(number)) throw new Error(`${name} must be a number.`);
      foodNutrients[name] = number;
    }

    return foodNutrients;
  }

  function foodSelections() {
    return [...document.querySelectorAll(".food-select")];
  }

  function visibleFoodSelections() {
    return foodSelections().filter(selection => selection.closest("tr").style.display !== "none");
  }

  function updateBulkDeleteControls() {
    const selections = foodSelections();
    const visibleSelections = visibleFoodSelections();
    const selectedCount = selections.filter(selection => selection.checked).length;

    deleteSelectedBtn.disabled = selectedCount === 0;
    deleteSelectedBtn.innerHTML = `<i class="fa fa-trash"></i> Delete selected${selectedCount ? ` (${selectedCount})` : ""}`;
    selectAllFoods.checked = visibleSelections.length > 0 && visibleSelections.every(selection => selection.checked);
    selectAllFoods.indeterminate = visibleSelections.some(selection => selection.checked) && !selectAllFoods.checked;
  }

  document.getElementById("addFoodBtn").addEventListener("click", () => {
    openEditor();
    modalTitle.innerText = "Add Food";
    deleteBtn.style.display = "none";
    modal.show();
  });

  addFoodNameBtn.addEventListener("click", () => addFoodName());
  addFoodPortionBtn.addEventListener("click", () => addFoodPortion());


  selectAllFoods.addEventListener("change", () => {
    visibleFoodSelections().forEach(selection => {
      selection.checked = selectAllFoods.checked;
    });
    updateBulkDeleteControls();
  });

  foodSelections().forEach(selection => {
    selection.addEventListener("change", updateBulkDeleteControls);
  });

  deleteSelectedBtn.addEventListener("click", async () => {
    const ids = foodSelections().filter(selection => selection.checked).map(selection => selection.value);
    if (ids.length === 0) return;
    if (!confirm(`Delete ${ids.length} selected food item${ids.length === 1 ? "" : "s"}?`)) return;

    const response = await fetch("/api/foods", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ids }),
    });

    if (response.ok) {
      location.reload();
      return;
    }

    const data = await response.json().catch(() => ({}));
    alert(data.message || "Failed to delete selected foods.");
  });

  document.querySelectorAll(".edit-btn").forEach(button => {
    button.addEventListener("click", () => {
      const row = button.closest("tr");
      try {
        const food = JSON.parse(row.dataset.food || "{}");
        food.id = row.dataset.id;
        openEditor(food);
        modalTitle.innerText = "Edit Food";
        deleteBtn.style.display = "inline-block";
        modal.show();
      } catch {
        alert("Unable to read this food item.");
      }
    });
  });

  deleteBtn.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!confirm("Delete this food item?")) return;
    const id = foodId.value;
    if (!id) return;

    const response = await fetch(`/api/foods/${id}`, { method: "DELETE" });
    if (response.ok) location.reload();
    else alert("Failed to delete food.");
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    let foodNutrients;
    let names;
    let foodPortions;
    try {
      foodNutrients = collectFoodNutrients();
      names = collectFoodNames();
      foodPortions = collectFoodPortions();
    } catch (error) {
      alert(error.message);
      return;
    }

    const food = {
      names,
      foodPortions,
      source: sourceInput.value.trim(),
      sourceId: sourceIdInput.value.trim(),
      foodNutrients,
    };
    const id = foodId.value;
    const response = await fetch(id ? `/api/foods/${id}` : "/api/foods", {
      method: id ? "PUT" : "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(food),
    });

    if (response.ok) {
      location.reload();
      return;
    }

    const data = await response.json().catch(() => ({}));
    alert(data.message || "Failed to save food.");
  });

  searchInput.addEventListener("input", () => {
    const filter = searchInput.value.toLowerCase();
    document.querySelectorAll("#db_body tr").forEach(row => {
      if (row.dataset.emptyState !== undefined) return;
      row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
    });
    updateBulkDeleteControls();
  });

  updateBulkDeleteControls();
});
</script>

</body>
</html>
