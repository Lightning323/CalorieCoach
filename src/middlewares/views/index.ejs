 <%
    function positiveNumber(value) {
      const number = Number(value);
      return Number.isFinite(number) && number > 0 ? number : null;
    }

    function formatNumber(value) {
      const number = Number(value);
      return Number.isFinite(number) && !Number.isInteger(number)
        ? number.toFixed(2).replace(/(\.\d*?)0+$/, "$1").replace(/\.$/, "")
        : String(number);
    }

    function pluralizedUnit(amount, unit) {
      const normalizedUnit = String(unit || "").trim();
      if (!normalizedUnit || amount === 1 || /^(g|mg|kg|oz|lb|ml|l|fl oz)$/i.test(normalizedUnit) || normalizedUnit.endsWith("s")) {
        return normalizedUnit;
      }
      if (normalizedUnit.endsWith("y")) return `${normalizedUnit.slice(0, -1)}ies`;
      if (normalizedUnit.endsWith("ch")) return `${normalizedUnit}es`;
      return `${normalizedUnit}s`;
    }

    function formatAmountUnit(amount, unit) {
      const parsedAmount = positiveNumber(amount);
      const normalizedUnit = String(unit || "").trim();
      if (!parsedAmount) return normalizedUnit || "Serving";
      return `${formatNumber(parsedAmount)} ${pluralizedUnit(parsedAmount, normalizedUnit || "serving")}`;
    }

    function metric(food, name) {
      const value = food?.foodNutrients?.[name] ?? 0;
      return Number.isFinite(Number(value)) ? Number(value) : 0;
    }

    function foodName(food) {
      const names = Array.isArray(food?.names) ? food.names.filter(name => typeof name === "string" && name.trim()) : [];
      return names[0] || "Unnamed food";
    }

    function portionUnit(portion) {
      const measureUnit = portion?.measureUnit;
      if (measureUnit && typeof measureUnit === "object") {
        const name = typeof measureUnit.name === "string" && measureUnit.name.trim()
          ? measureUnit.name.trim()
          : typeof measureUnit.abbreviation === "string" && measureUnit.abbreviation.trim()
            ? measureUnit.abbreviation.trim()
            : "";
        if (name) return name;
      }

      // Retain readability for food logs created before the USDA-style schema.
      return typeof portion?.unit === "string" && portion.unit.trim() ? portion.unit.trim() : "";
    }

    function portionDescription(portion) {
      return [portion?.disseminationText, portion?.portionDescription, portion?.modifier]
        .find(value => typeof value === "string" && value.trim())?.trim() || "";
    }

    function portionGramWeight(portion) {
      return positiveNumber(portion?.gramWeight) ?? positiveNumber(portion?.grams);
    }

    function portionLabel(portion, fallbackAmount) {
      const unit = portionUnit(portion);
      const amount = positiveNumber(portion?.amount) ?? positiveNumber(fallbackAmount);
      if (unit && amount) return formatAmountUnit(amount, unit);
      return portionDescription(portion) || unit || "Serving";
    }

    function primaryFoodPortion(food) {
      const portions = Array.isArray(food?.foodPortions) ? food.foodPortions : [];
      const primaryPortion = [...portions].sort((left, right) => Number(left.rank) - Number(right.rank))[0];
      return portionLabel(primaryPortion);
    }

    function scaledServing(quantity, serving) {
      const match = String(serving || "").trim().match(/^(\d+(?:\.\d+)?)\s+(.+)$/);
      return match
        ? formatAmountUnit(Number(match[1]) * Number(quantity), match[2])
        : formatAmountUnit(quantity, serving);
    }

    function loggedPortion(food) {
      const portion = food?.portion;
      if (portion) {
        const enteredPortion = portionLabel(portion, food.quantity);
        const grams = portionGramWeight(portion);
        return grams ? `${enteredPortion} · ${formatNumber(grams)} g` : enteredPortion;
      }
      return scaledServing(food?.quantity, primaryFoodPortion(food?.foodItem ?? food?.food ?? food?.backup_foodItem));
    }
    %>    
    
    <!DOCTYPE html>
    <html lang="en">

    <head>
      <%- include('partials/head.ejs') %>
        <title>Calorie Coach</title>
    </head>

    <body>
      <%- include('partials/header.ejs') %>

        <div class="container my-4">
          <section id="loadingOverlay" class="card border-info shadow-sm mb-4 d-none" role="status" aria-live="polite">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <strong><i class="fa fa-spinner fa-spin"></i> Logging food</strong>
                <span id="logProgressPercent" class="text-muted">0%</span>
              </div>
              <div class="progress mb-3" style="height: 10px;">
                <div
                  id="logProgressBar"
                  class="progress-bar progress-bar-striped progress-bar-animated"
                  role="progressbar"
                  style="width: 0%"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                ></div>
              </div>
              <ul id="logProgressSteps" class="list-group list-group-flush small"></ul>
            </div>
          </section>
    
          <form id="logFoodForm" class="card p-3 shadow-sm mb-4">
            <div class="mb-3">
              <label for="foodItems" class="form-label">
                What did you eat?
              </label>
              <textarea id="foodItems" name="foodItems" class="form-control" rows="3"
                placeholder="e.g. 1 cup strawberry lemonade, 2 bananas, 1 snickers bar" required></textarea>
            </div>
            <button id="logFoodBtn" class="btn btn-primary w-100 fw-semibold" type="submit">
              Log Food
            </button>
          </form>

         <%- include('./index-consumption.ejs') %>


        
          <h2>Logged Today</h2>
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Food</th>
                <th>Quantity</th>
                <th><i class="fa fa-fire"></i></th>
                <th><i class="fa fa-dumbbell"></i></th>
                <th></th>
              </tr>
            </thead>
            <tbody id="todayFoodsBody">
              <% if (todayFoods.length===0) { %>
                <tr id="todayFoodsEmptyState">
                  <td colspan="5" class="text-center text-muted">No food logged yet...</td>
                </tr>
                <% } %>
                  <% todayFoods.forEach(food=> {
                    const foodItem = food.foodItem ?? food.food ?? food.backup_foodItem;
                  %>
                    <% if (foodItem) { %>
                      <tr data-log-id="<%= food._id %>">
                        <td>
                          <%= foodName(foodItem) %>
                        </td>
                        <td>
                          <%= loggedPortion(food) %>
                        </td>
                        <td>
                          <%= Math.round(metric(foodItem, "calories") * food.quantity) %>
                        </td>
                        <td>
                          <%= Math.round(metric(foodItem, "protein") * food.quantity)%>g
                        </td>
                        <td>
                          <button class="btn btn-sm btn-primary editFoodBtn" data-log-id="<%= food._id %>"
                            data-log-date="<%= food.logDate %>" data-food-name="<%= foodName(foodItem) %>"
                            data-food-quantity="<%= primaryFoodPortion(foodItem) %>"
                            data-food-calories="<%= metric(foodItem, "calories") %>"
                            data-food-protein="<%= metric(foodItem, "protein") %>"
                            data-food-carbs="<%= metric(foodItem, "carbs") %>" data-food-fat="<%= metric(foodItem, "fat") %>"
                            data-quantity="<%= food.quantity %>" data-notes="<%= food.notes %>"
                            data-portion-amount="<%= food.portion?.amount ?? "" %>"
                            data-portion-unit="<%= portionUnit(food.portion) %>"
                            data-portion-grams="<%= portionGramWeight(food.portion) ?? "" %>"> <i
                              class="fa fa-edit"></i> </button>
                        </td>
                      </tr>
                      <% } else { %>
                        <tr class="text-muted">
                          <td colspan="5"><i class="fa fa-triangle-exclamation"></i> This food entry no longer exists
                          </td>
                        </tr>
                        <% } %>
                          <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Edit Food Modal -->
        <div class="modal fade" id="editFoodModal" tabindex="-1">
          <div class="modal-dialog">
            <form class="modal-content" id="editFoodForm" action="/edit-day-food" method="POST">
              <input type="hidden" name="foodLogId" id="editFoodId">
              <input type="hidden" name="portionAmount" id="editFoodPortionAmount">
              <div class="modal-header">
                <h5 class="modal-title">Edit Food</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <p>Entry (<span id="loggedAt"></span>)</p>
                  <p class="form-control">
                    <span id="foodEntry"></span>
                    <b>(<span id="foodQuantity"></span>)</b>
                  </p>
                  <p class="form-control" id="foodMacros"></p>
                </div>
                <div class="mb-3">
                  <label id="editFoodQuantityLabel">Quantity</label>
                  <input class="form-control" name="quantity" id="editFoodQuantity" type="number" step="any">
                </div>
              </div>
              <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-danger" id="deleteFoodBtn"><i class="fa fa-trash"></i>
                  Delete</button>
                <div>
                  <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                  <button class="btn btn-success" type="submit">Save</button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Change Calorie Goal Modal -->
        <div class="modal fade" id="goalModal" tabindex="-1">
          <div class="modal-dialog">
            <form class="modal-content" action="/nutrition-goals" method="POST">
              <div class="modal-header">
                <h5 class="modal-title">Change Nutrition Goals</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <label class="form-label">Maintenance Calories (kcal)  <a href="https://www.calculator.net/calorie-calculator.html" target="_blank"><i class="fa fa-question-circle"></i></a></label>
  
                <input name="maintenanceCalories" type="number" class="form-control mb-3" value="<%= maintenanceCalories %>" required />
                <label class="form-label">Calorie Offset (kcal)</label>
                <input name="calorieOffset" type="number" class="form-control mb-3" value="<%= calorieOffset %>" required />
                <label class="form-label">Protein Goal (g)</label>
                <input name="proteinGoal" type="number" class="form-control" value="<%= proteinGoal %>" required />
              </div>
              <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cancel</button>
                <button class="btn btn-success">Save</button>
              </div>
            </form>
          </div>
        </div>
        <%- include('partials/footer') %>
          <!-- <p style="color: white;user-select: all;"><%- JSON.stringify(logData) %></p> -->
          <script>
            const loadingOverlay = document.getElementById("loadingOverlay");
            const logProgressBar = document.getElementById("logProgressBar");
            const logProgressPercent = document.getElementById("logProgressPercent");
            const logProgressSteps = document.getElementById("logProgressSteps");
            const logFoodForm = document.getElementById("logFoodForm");
            const logFoodBtn = document.getElementById("logFoodBtn");
            const foodItemsTextarea = document.getElementById("foodItems");
            const todayFoodsBody = document.getElementById("todayFoodsBody");
            const editModal = new bootstrap.Modal(document.getElementById("editFoodModal"));

            function positiveNumber(value) {
              const number = Number(value);
              return Number.isFinite(number) && number > 0 ? number : null;
            }

            function formatNumber(value) {
              const number = Number(value);
              return Number.isFinite(number) && !Number.isInteger(number)
                ? number.toFixed(2).replace(/(\.\d*?)0+$/, "$1").replace(/\.$/, "")
                : String(number);
            }

            function pluralizedUnit(amount, unit) {
              const normalizedUnit = String(unit || "").trim();
              if (!normalizedUnit || amount === 1 || /^(g|mg|kg|oz|lb|ml|l|fl oz)$/i.test(normalizedUnit) || normalizedUnit.endsWith("s")) {
                return normalizedUnit;
              }
              if (normalizedUnit.endsWith("y")) return `${normalizedUnit.slice(0, -1)}ies`;
              if (normalizedUnit.endsWith("ch")) return `${normalizedUnit}es`;
              return `${normalizedUnit}s`;
            }

            function formatAmountUnit(amount, unit) {
              const parsedAmount = positiveNumber(amount);
              const normalizedUnit = String(unit || "").trim();
              if (!parsedAmount) return normalizedUnit || "Serving";
              return `${formatNumber(parsedAmount)} ${pluralizedUnit(parsedAmount, normalizedUnit || "serving")}`;
            }

            function portionUnit(portion) {
              const measureUnit = portion?.measureUnit;
              if (measureUnit && typeof measureUnit === "object") {
                const name = typeof measureUnit.name === "string" && measureUnit.name.trim()
                  ? measureUnit.name.trim()
                  : typeof measureUnit.abbreviation === "string" && measureUnit.abbreviation.trim()
                    ? measureUnit.abbreviation.trim()
                    : "";
                if (name) return name;
              }
              return typeof portion?.unit === "string" && portion.unit.trim() ? portion.unit.trim() : "";
            }

            function portionDescription(portion) {
              return [portion?.disseminationText, portion?.portionDescription, portion?.modifier]
                .find(value => typeof value === "string" && value.trim())?.trim() || "";
            }

            function portionGramWeight(portion) {
              return positiveNumber(portion?.gramWeight) ?? positiveNumber(portion?.grams);
            }

            function addProgressStep(progress, message, isError = false) {
              const safeProgress = Math.max(0, Math.min(100, Number(progress) || 0));
              logProgressBar.style.width = `${safeProgress}%`;
              logProgressBar.setAttribute("aria-valuenow", safeProgress);
              logProgressPercent.textContent = `${safeProgress}%`;

              logProgressSteps.innerHTML = "";
              const step = document.createElement("li");
              step.className = `list-group-item px-0 py-1${isError ? " text-danger" : ""}`;
              step.textContent = message;
              console.log("LOGGING FOOD", message);
              logProgressSteps.append(step);
            }

            function beginFoodLog() {
              loadingOverlay.className = "card border-info shadow-sm mb-4";
              logProgressBar.className = "progress-bar progress-bar-striped progress-bar-animated";
              logProgressSteps.replaceChildren();
              addProgressStep(2, "Food log queued.");
              logFoodBtn.disabled = true;
              foodItemsTextarea.disabled = true;
            }

            function finishFoodLog() {
              loadingOverlay.className = "d-none";
              logFoodBtn.disabled = false;
              foodItemsTextarea.disabled = false;
              foodItemsTextarea.focus();
            }

            function foodMetric(food, name) {
              const value = food?.foodNutrients?.[name] ?? 0;
              const number = Number(value);
              return Number.isFinite(number) ? number : 0;
            }

            function displayFoodName(food) {
              const names = Array.isArray(food?.names)
                ? food.names.filter(name => typeof name === "string" && name.trim())
                : [];
              return names[0] || "Unnamed food";
            }

            function displayFoodServing(food) {
              const portions = Array.isArray(food?.foodPortions) ? food.foodPortions : [];
              const portion = [...portions].sort((left, right) => Number(left.rank) - Number(right.rank))[0];
              const amount = positiveNumber(portion?.amount);
              const unit = portionUnit(portion);
              if (amount && unit) return `${formatNumber(amount)} ${unit}`;
              return portionDescription(portion) || unit || "serving";
            }

            function formatServing(quantity, serving) {
              const match = String(serving || "").trim().match(/^(\d+(?:\.\d+)?)\s+(.+)$/);
              if (!match) return `${quantity} × ${serving || "serving"}`;
              const amount = Number(match[1]) * quantity;
              return formatAmountUnit(amount, match[2]);
            }

            function formatPortion(portion, quantity, serving) {
              const amount = positiveNumber(portion?.amount) ?? positiveNumber(quantity);
              const unit = portionUnit(portion);
              if (amount && unit) {
                const enteredPortion = formatAmountUnit(amount, unit);
                const grams = portionGramWeight(portion);
                return grams ? `${enteredPortion} · ${formatNumber(grams)} g` : enteredPortion;
              }
              const description = portionDescription(portion);
              if (description) return description;
              return formatServing(quantity, serving);
            }

            function openEditFoodModal(button) {
              if (!button.dataset.foodName) return alert("This food entry no longer exists.");

              document.getElementById("editFoodId").value = button.dataset.logId;
              document.getElementById("foodEntry").textContent = button.dataset.foodName;
              const portionAmount = Number(button.dataset.portionAmount);
              const portionUnitName = String(button.dataset.portionUnit || "").trim();
              const portionGrams = Number(button.dataset.portionGrams);
              const hasPortion = Number.isFinite(portionAmount) && portionAmount > 0 && portionUnitName;
              document.getElementById("foodQuantity").textContent = hasPortion
                ? formatPortion({ amount: portionAmount, measureUnit: { name: portionUnitName }, gramWeight: portionGrams })
                : button.dataset.foodQuantity;

              const foodMacros = document.getElementById("foodMacros");
              foodMacros.replaceChildren();
              const multiplier = Number(button.dataset.quantity) || 0;
              [
                `${Math.round((Number(button.dataset.foodCalories) || 0) * multiplier)} kcal`,
                `${Math.round((Number(button.dataset.foodProtein) || 0) * multiplier)}g protein`,
                `${Math.round((Number(button.dataset.foodCarbs) || 0) * multiplier)}g carbs`,
                `${Math.round((Number(button.dataset.foodFat) || 0) * multiplier)}g fat`,
              ].forEach(text => {
                const line = document.createElement("div");
                line.textContent = `- ${text}`;
                foodMacros.append(line);
              });

              document.getElementById("loggedAt").textContent = new Date(button.dataset.logDate)
                .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
              document.getElementById("editFoodQuantityLabel").textContent = hasPortion
                ? `Amount (${portionUnitName})`
                : "Quantity";
              document.getElementById("editFoodQuantity").value = hasPortion
                ? portionAmount
                : button.dataset.quantity;
              document.getElementById("editFoodPortionAmount").value = hasPortion ? portionAmount : "";
              document.getElementById("editFoodPortionAmount").dataset.active = hasPortion ? "true" : "false";
              editModal.show();
            }

            function bindEditButton(button) {
              button.addEventListener("click", () => openEditFoodModal(button));
            }

            function appendLoggedFood(entry) {
              if (!entry?.id || !entry.food || document.querySelector(`[data-log-id="${entry.id}"]`)) return false;

              document.getElementById("todayFoodsEmptyState")?.remove();
              const row = document.createElement("tr");
              row.dataset.logId = entry.id;
              const foodName = displayFoodName(entry.food);
              const calories = Math.round(foodMetric(entry.food, "calories") * entry.quantity);
              const protein = Math.round(foodMetric(entry.food, "protein") * entry.quantity);
              const carbs = foodMetric(entry.food, "carbs");
              const fat = foodMetric(entry.food, "fat");

              [foodName, formatPortion(entry.portion, entry.quantity, displayFoodServing(entry.food)), calories, `${protein}g`]
                .forEach(value => {
                  const cell = document.createElement("td");
                  cell.textContent = String(value);
                  row.append(cell);
                });

              const actionCell = document.createElement("td");
              const editButton = document.createElement("button");
              editButton.type = "button";
              editButton.className = "btn btn-sm btn-primary editFoodBtn";
              editButton.setAttribute("aria-label", `Edit ${foodName}`);
              editButton.innerHTML = '<i class="fa fa-edit"></i>';
              editButton.dataset.logId = entry.id;
              editButton.dataset.logDate = entry.loggedAt;
              editButton.dataset.foodName = foodName;
              editButton.dataset.foodQuantity = displayFoodServing(entry.food);
              editButton.dataset.foodCalories = foodMetric(entry.food, "calories");
              editButton.dataset.foodProtein = foodMetric(entry.food, "protein");
              editButton.dataset.foodCarbs = carbs;
              editButton.dataset.foodFat = fat;
              editButton.dataset.quantity = entry.quantity;
              editButton.dataset.notes = entry.notes || "";
              editButton.dataset.portionAmount = entry.portion?.amount ?? "";
              editButton.dataset.portionUnit = portionUnit(entry.portion);
              editButton.dataset.portionGrams = portionGramWeight(entry.portion) ?? "";
              bindEditButton(editButton);
              actionCell.append(editButton);
              row.append(actionCell);
              todayFoodsBody.prepend(row);
              return true;
            }

            function updateTodayNutrition(entries) {
              const nutrition = document.getElementById("todayNutrition");
              if (!nutrition || entries.length === 0) return;

              const calorieGoal = Number(nutrition.dataset.calorieGoal) || 0;
              const proteinGoal = Number(nutrition.dataset.proteinGoal) || 0;
              const calorieTolerance = Number(nutrition.dataset.calorieTolerance) || 0;
              const addedCalories = entries.reduce((total, entry) =>
                total + (foodMetric(entry.food, "calories") * entry.quantity), 0);
              const addedProtein = entries.reduce((total, entry) =>
                total + (foodMetric(entry.food, "protein") * entry.quantity), 0);
              const calories = (Number(nutrition.dataset.calories) || 0) + addedCalories;
              const protein = (Number(nutrition.dataset.protein) || 0) + addedProtein;
              nutrition.dataset.calories = calories;
              nutrition.dataset.protein = protein;

              document.getElementById("todayCaloriesValue").textContent = Math.round(calories);
              document.getElementById("todayProteinValue").textContent = Math.round(protein);

              const overGoal = calories > calorieGoal + calorieTolerance;
              const calorieBar = document.getElementById("calorieProgressBar");
              calorieBar.style.width = `${Math.min((calories / calorieGoal) * 100, 100)}%`;
              calorieBar.classList.toggle("bg-danger", overGoal);
              calorieBar.classList.toggle("bg-success", !overGoal);
              const calorieStatus = document.getElementById("calorieGoalStatus");
              calorieStatus.className = `${overGoal ? "text-danger" : "text-success"} mt-1 text-center`;
              calorieStatus.textContent = overGoal
                ? `${Math.round(calories - calorieGoal)} kcal over your limit`
                : `${Math.max(0, Math.round(calorieGoal - calories))} kcal remaining`;

              const proteinReached = protein >= proteinGoal;
              const proteinBar = document.getElementById("proteinProgressBar");
              proteinBar.style.width = `${proteinGoal > 0 ? Math.min((protein / proteinGoal) * 100, 100) : 0}%`;
              proteinBar.classList.toggle("bg-info", proteinReached);
              proteinBar.classList.toggle("bg-primary", !proteinReached);
              document.getElementById("proteinGoalStatus").textContent = proteinReached
                ? "Protein goal reached"
                : `${Math.round(proteinGoal - protein)}g to go`;
            }
       
            logFoodForm.addEventListener("submit", (event) => {
              event.preventDefault();
              const foodItems = foodItemsTextarea.value.trim();
              if (!foodItems || logFoodBtn.disabled) return;

              beginFoodLog();
              socket.emit("log-food", { foodItems });
              foodItemsTextarea.value = "";
            });

            socket.on("food-log-queued", () => {
              addProgressStep(5, "Preparing saved food database lookup.");
            });

            socket.on("food-log-progress", ({ progress, message }) => {
              addProgressStep(progress, message);
            });

            socket.on("food-log-error", ({ message }) => {
              loadingOverlay.classList.remove("border-info");
              loadingOverlay.classList.add("border-danger");
              logProgressBar.classList.remove("progress-bar-animated");
              logProgressBar.classList.add("bg-danger");
              addProgressStep(Number(logProgressBar.getAttribute("aria-valuenow")) || 0, message, true);
              finishFoodLog();
              showBulletin(message);
            });

            socket.on("food-logged", ({ message, entries = [] }) => {
              const addedEntries = entries.filter(appendLoggedFood);
              updateTodayNutrition(addedEntries);

              if (logFoodBtn.disabled) {
                addProgressStep(100, message);
                logProgressBar.classList.remove("progress-bar-animated");
                logProgressBar.classList.add("bg-success");
                finishFoodLog();
              }
            });

            document.querySelectorAll(".editFoodBtn").forEach(bindEditButton);

            document.getElementById("editFoodForm").addEventListener("submit", () => {
              const portionAmount = document.getElementById("editFoodPortionAmount");
              if (portionAmount.dataset.active === "true") {
                portionAmount.value = document.getElementById("editFoodQuantity").value;
              }
            });

            document.getElementById("deleteFoodBtn").addEventListener("click", () => {
              const logId = document.getElementById("editFoodId").value;
              if (!logId) return;

              fetch("/delete-food", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ foodLogId: logId }),
              }).then(() => location.reload());
            });
          </script>

    </body>

    </html>
