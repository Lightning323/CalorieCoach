<% const loggedFoods = Array.isArray(viewedFoods) ? viewedFoods : [];
  const foodLogHistory = locals.foodLogHistory && typeof locals.foodLogHistory === "object"
    ? locals.foodLogHistory
    : {};
  const foodMetric=(food, name)=> Number(food?.foodNutrients?.[name] ?? 0) || 0;
  const hasFoodMetric = (food, name) => Number.isFinite(Number(food?.foodNutrients?.[name]));
  const formatNutrientAmount = value => {
  const number = Number(value) || 0;
  return Number.isInteger(number)
  ? String(Math.round(number))
  : number.toFixed(1).replace(/\.0$/, "");
  };
  const wellnessGoals = Array.isArray(locals.wellnessNutrientGoals) ? locals.wellnessNutrientGoals : [];
  const totalCalories=loggedFoods.reduce((sum, f)=> sum + (f.nutrition?.calories ?? 0), 0);
  const totalProtein = loggedFoods.reduce((sum, f) => sum + (f.nutrition?.protein ?? 0),
  0);
  const totalCarbs = loggedFoods.reduce((sum, f) => sum + (f.nutrition?.carbs ?? 0), 0);
  const totalFat = loggedFoods.reduce((sum, f) => sum + (f.nutrition?.fat ?? 0), 0);
  const nutrientSummary = wellnessGoals.map(goal => {
  const hasData = loggedFoods.some(food => hasFoodMetric(food.foodItem, goal.key));
  const total = loggedFoods.reduce((sum, food) => sum + (Number(food.nutrition?.[goal.key]) || 0), 0);
  const progress = hasData && goal.target > 0 ? Math.min((total / goal.target) * 100, 100) : 0;
  return { ...goal, total, hasData, progress, reached: hasData && total >= goal.target };
  });
  const nutrientProgressData = Object.fromEntries(nutrientSummary.map(nutrient => [nutrient.key, {
  total: nutrient.total,
  target: nutrient.target,
  unit: nutrient.unit,
  hasData: nutrient.hasData,
  }]));
  const nutrientDataAvailable = nutrientSummary.some(nutrient => nutrient.hasData);
  const nutrientGoalsReached = nutrientSummary.filter(nutrient => nutrient.reached).length;
  const nutrientCoverageStatus = nutrientDataAvailable
  ? `${nutrientGoalsReached} of ${nutrientSummary.length} targets met`
  : "Add food to see coverage";

  function calorieGoal(){
  return maintenanceCalories + calorieOffset;
  }

  const percent = Math.min((totalCalories / calorieGoal()) * 100, 100);
  const calorieGoalTolerance = 20;
  const overGoal = totalCalories > calorieGoal()+calorieGoalTolerance;

  const rawMeals = Array.isArray(locals.meals) ? locals.meals : [];
  const mealConfig = rawMeals
    .filter(meal => meal && typeof meal === "object")
    .map(meal => ({
      name: typeof meal.name === "string" && meal.name.trim() ? meal.name.trim() : "Meal",
      percentage: Math.max(0, Math.min(100, Number(meal.percentage) || 0)),
    }))
    .filter(meal => meal.percentage > 0)
    .slice(0, 4);
  const mealsToShow = mealConfig.length > 0 ? mealConfig : [
    { name: "Breakfast", percentage: 25 },
    { name: "Lunch", percentage: 35 },
    { name: "Dinner", percentage: 30 },
    { name: "Snack", percentage: 10 },
  ];
  const totalMealPercent = mealsToShow.reduce((sum, meal) => sum + meal.percentage, 0);
  const normalizedMeals = totalMealPercent > 0
    ? mealsToShow.map(meal => ({ ...meal, percentage: (meal.percentage / totalMealPercent) * 100 }))
    : mealsToShow;
  const calorieGoalValue = calorieGoal();
  let mealCumulative = 0;
  const mealSegments = normalizedMeals.map((meal, index) => {
    const startPercent = mealCumulative;
    mealCumulative += meal.percentage;
    const endPercent = mealCumulative;
    const mealCalories = (calorieGoalValue * meal.percentage) / 100;
    const mealConsumed = 0; // For now, we don't have meal-level tracking
    return {
      ...meal,
      index,
      startPercent,
      endPercent,
      mealCalories,
      consumed: mealConsumed,
      remaining: Math.max(0, mealCalories - mealConsumed),
    };
  });
  // Find current meal based on progress
  const progressPercent = calorieGoalValue > 0 ? (totalCalories / calorieGoalValue) * 100 : 0;
  let currentMeal = mealSegments[0];
  for (let i = 0; i < mealSegments.length; i++) {
    if (progressPercent >= mealSegments[i].startPercent && progressPercent < mealSegments[i].endPercent) {
      currentMeal = mealSegments[i];
      break;
    } else if (i === mealSegments.length - 1 && progressPercent >= mealSegments[i].startPercent) {
      currentMeal = mealSegments[i];
    }
  }
  let mealRemainingText = "";
  if (overGoal) {
    mealRemainingText = "";
  } else if (currentMeal) {
    const mealTotal = (calorieGoalValue * currentMeal.percentage) / 100;
    const consumedInMealApprox = totalCalories * (currentMeal.percentage / 100) / (progressPercent / 100 || 1);
    mealRemainingText = `${Math.max(0, Math.round(mealTotal - consumedInMealApprox))} kcal left for ${currentMeal.name.toLowerCase()}`;
  } else {
    mealRemainingText = `${Math.max(0, Math.round(calorieGoalValue - totalCalories))} kcal remaining`;
  }

  const proteinProgress = proteinGoal > 0 ? Math.min((totalProtein / proteinGoal) * 100, 100) : 0;
  const proteinGoalReached = totalProtein >= proteinGoal;


  // Each day is now retained as a full food-log list. Build the history totals
  // from that canonical map rather than from a second stored journal.
  const foodHistory = Object.fromEntries(Object.entries(foodLogHistory)
    .filter(([date, foods]) => /^\d{4}-\d{2}-\d{2}$/.test(date) && Array.isArray(foods) && foods.length > 0)
    .map(([date, foods]) => [date, foods.reduce((totals, food) => ({
      calories: totals.calories + (Number(food?.nutrition?.calories) || 0),
      protein: totals.protein + (Number(food?.nutrition?.protein) || 0),
      carbs: totals.carbs + (Number(food?.nutrition?.carbs) || 0),
      fat: totals.fat + (Number(food?.nutrition?.fat) || 0),
    }), { calories: 0, protein: 0, carbs: 0, fat: 0 })]));
  const sortedDates = Object.keys(foodHistory).sort((a,b)=> new Date(`${a}T00:00:00Z`).getTime() - new Date(`${b}T00:00:00Z`).getTime());
  const today = new Date(`${todayDate}T00:00:00.000Z`).getTime();
  const rangeEnd = today; //Our end date (today)
  const historyTimeWindowDays = 30;
  const rangeStart = new Date(rangeEnd);//Our start date (N days ago)
  rangeStart.setUTCDate(rangeStart.getUTCDate() - historyTimeWindowDays);


  //Get sorted dates, but only keep the ones that are between the start and end dates
  const lastNDates = sortedDates.filter(dateStr => {
  const d = new Date(`${dateStr}T00:00:00.000Z`).getTime();
  return d >= rangeStart && d <= rangeEnd; }).sort((a,b)=> new Date(a).getTime() - new Date(b).getTime());

    const totalCaloriesInRange = lastNDates.reduce((sum, date) => sum + (foodHistory[date].calories ?? 0), 0);
    const totalProteinInRange = lastNDates.reduce((sum, date) => sum + (foodHistory[date].protein ?? 0), 0);
    const totalCarbsInRange = lastNDates.reduce((sum, date) => sum + (foodHistory[date].carbs ?? 0), 0);
    const totalFatInRange = lastNDates.reduce((sum, date) => sum + (foodHistory[date].fat ?? 0), 0);

    const caloriesDelta = totalCaloriesInRange - (calorieGoal() * lastNDates.length);
    const proteinDelta = totalProteinInRange - (proteinGoal * lastNDates.length);


    %>
    <div class="card p-3 shadow-sm mb-4" id="todayNutrition" data-calories="<%= totalCalories %>"
      data-protein="<%= totalProtein %>" data-calorie-goal="<%= calorieGoal() %>" data-protein-goal="<%= proteinGoal %>"
      data-calorie-tolerance="<%= calorieGoalTolerance %>"
      data-nutrient-progress='<%- JSON.stringify(nutrientProgressData) %>' data-meals='<%- JSON.stringify(normalizedMeals) %>'>

  <div>
    <!-- <h5 class="mb-3"><i class="fa fa-fire"></i> <%= viewedDateLabel %></h5> -->
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h5 class="mb-0">
        <strong>
          <span id="todayCaloriesValue">
            <%= Math.round(totalCalories) %>
          </span> / <%= Math.round(calorieGoal()) %> kcal
        </strong>
        <span class="text-muted" style="font-size: 0.8em;text-wrap:nowrap;">
          (<%= maintenanceCalories %>
            <%= calorieOffset> 0 ? "+" : "" %><%= Math.round(calorieOffset) %> kcal)
        </span>

      </h5>
      <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#goalModal">
        Change Goal
      </button>
    </div>

        <div class="progress mb-3 meal-progress-wrapper">
          <% mealSegments.forEach((segment, idx) => { if (idx < mealSegments.length - 1) { %>
            <div class="meal-divider" style="left: <%= segment.endPercent %>%;"></div>
          <% } }); %>
          <div id="calorieProgressBar" class="progress-bar <%= overGoal ? 'bg-danger' : 'bg-success' %> meal-progress-segment"
            role="progressbar" style="width: <%= Math.min(progressPercent, 100) %>%;">
          </div>
        </div>

        <% if (overGoal) { %>
          <div id="calorieGoalStatus" class="text-danger mt-1 text-center">
            <i class="fa-solid fa-triangle-exclamation"></i><strong>
              <%= Math.round(totalCalories-calorieGoal()) %>
            </strong> kcal over your limit
          </div>
          <% } else { %>
            <div id="calorieGoalStatus" class="text-success mt-1 text-center">
              <i class="fa fa-fire"></i> <strong>
                <%= Math.max(0, Math.round(calorieGoal() - totalCalories)) %>
              </strong> kcal remaining
            </div>
            <div id="mealRemainingStatus" class="text-muted mt-1 text-center" style="font-size: 0.9em;">
              <%= mealRemainingText %>
            </div>
            <% } %>

              <hr>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">
                  <strong>


                    <span id="todayProteinValue">
                      <%= Math.round(totalProtein) %>
                    </span> / <%= Math.round(proteinGoal) %>g protein
                  </strong>
                </h5>
                <small class="text-muted" id="proteinGoalStatus">
                  <% if (proteinGoalReached) { %> Protein goal reached
                    <% } else { %>
                      <%= Math.round(proteinGoal - totalProtein) %>g</strong> to go
                        <% } %>
                </small>
              </div>

              <div class="progress" style="height: 10px;">
                <div id="proteinProgressBar" class="progress-bar <%= proteinGoalReached ? 'bg-info' : 'bg-primary' %>"
                  role="progressbar" style="width: <%= proteinProgress %>%">
                </div>
              </div>
              <% if (!proteinGoalReached) { %>
                <div id="proteinMealStatus" class="text-muted mt-1 text-center" style="font-size: 0.9em;">
                  <%= Math.round(proteinGoal - totalProtein) %>g protein left for <%= currentMeal && currentMeal.name ? currentMeal.name.toLowerCase() : "this meal" %>
                </div>
              <% } %>

              <hr>
              <button id="nutrientCoverageToggle" class="nutrient-coverage-toggle" type="button"
                data-bs-toggle="collapse" data-bs-target="#nutritionDetails" aria-expanded="false"
                aria-controls="nutritionDetails">
                <span class="nutrient-coverage-copy">
                  <span class="nutrient-coverage-heading">
                    <i class="fa-solid fa-seedling" aria-hidden="true"></i> Nutrient coverage
                  </span>
                  <span id="nutrientCoverageStatus" class="nutrient-coverage-status">
                    <%= nutrientCoverageStatus %>
                  </span>
                </span>
                <span id="nutrientCoverageStrip" class="nutrient-coverage-strip" role="img"
                  aria-label="Nutrient coverage: <%= nutrientCoverageStatus %>">
                  <% nutrientSummary.forEach(nutrient=> { %>
                    <span
                      class="nutrient-segment nutrient-<%= nutrient.color %> <%= nutrient.hasData ? '' : 'nutrient-data-unavailable' %>"
                      data-nutrient-segment="<%= nutrient.key %>"
                      title="<%= nutrient.label %>: <%= nutrient.hasData ? `${formatNutrientAmount(nutrient.total)} of ${formatNutrientAmount(nutrient.target)} ${nutrient.unit}` : 'No nutrition data available' %>">
                      <span class="nutrient-segment-fill" style="width: <%= nutrient.progress %>%"></span>
                      <span class="nutrient-segment-label">
                        <%= nutrient.shortLabel %>
                      </span>
                    </span>
                    <% }); %>
                </span>
                <i class="fa fa-chevron-down nutrient-coverage-chevron" aria-hidden="true"></i>
              </button>

      </div>

 

      <div class="collapse mt-3" id="nutritionDetails">
             <div class="horizontal-divider"></div>
        <div>
          <h5 class="mb-2"><i class="fa-solid fa-seedling"></i> Nutrient goals</h5>
          <!-- <p class="small text-muted mb-3">These are general adult reference targets from food logs, not a diagnosis or personalized medical advice.</p> -->
          <div class="nutrient-detail-list mb-4">
            <% nutrientSummary.forEach(nutrient=> { %>
              <div class="nutrient-detail-row" data-nutrient-row="<%= nutrient.key %>">
                <div class="d-flex justify-content-between align-items-baseline gap-3">
                  <span class="fw-semibold">
                    <%= nutrient.label %>
                  </span>
                  <span class="small text-muted text-nowrap" data-nutrient-value="<%= nutrient.key %>">
                    <%= nutrient.hasData ? `${formatNutrientAmount(nutrient.total)} /
                      ${formatNutrientAmount(nutrient.target)} ${nutrient.unit}` : 'No data' %>
                  </span>
                </div>
                <div class="progress nutrient-detail-progress" role="progressbar" aria-label="<%= nutrient.label %>"
                  aria-valuemin="0" aria-valuemax="<%= nutrient.target %>"
                  aria-valuenow="<%= nutrient.hasData ? nutrient.total : 0 %>">
                  <div
                    class="progress-bar nutrient-detail-fill nutrient-<%= nutrient.color %> <%= nutrient.hasData ? '' : 'nutrient-data-unavailable' %>"
                    data-nutrient-detail-fill="<%= nutrient.key %>" style="width: <%= nutrient.progress %>%"></div>
                </div>
              </div>
              <% }); %>
          </div>

          <div class="horizontal-divider"></div>

          <h5 class="mb-3"><i class="fa fa-history"></i> History</h5>
          <% if (Object.keys(foodHistory).length > 0) { %>
            <% if (lastNDates.length> 0) { %>
              <div class="small mb-3">
                <% const avgDailyTotalCalories=Math.round(totalCaloriesInRange / lastNDates.length); const
                  avgDailyTotalProtein=Math.round(totalProteinInRange / lastNDates.length); const
                  avgDailyTotalCarbs=Math.round(totalCarbsInRange / lastNDates.length); const
                  avgDailyTotalFat=Math.round(totalFatInRange / lastNDates.length); %>
                  Daily average over <%= historyTimeWindowDays %> days:
                    <span
                      class="text-nowrap <%= avgDailyTotalCalories > calorieGoal() + calorieGoalTolerance ? 'text-danger' : 'text-success' %>">
                      <strong>
                        <%= avgDailyTotalCalories %> kcal
                      </strong>
                    </span>
                    <span
                      class="text-nowrap <%= avgDailyTotalProtein < proteinGoal ? 'text-danger' : 'text-success' %>">
                      <strong>
                        <%= avgDailyTotalProtein %>g
                      </strong> protein
                    </span>
                    <span class="text-muted text-nowrap">
                      <strong>
                        <%= avgDailyTotalCarbs %>g
                      </strong> carbs, <strong>
                        <%= avgDailyTotalFat %>g
                      </strong> fat
                    </span>
              </div>
              <% } %>

                <ul class="nav nav-tabs" id="myTab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home"
                      type="button" role="tab">Weekly average</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile"
                      type="button" role="tab">Daily totals</button>
                  </li>
                </ul>

                <!--
    Weekly and daily consumption
    -->
                <div class="tab-content" id="myTabContent">
                  <div class="tab-pane fade show active" id="home" role="tabpanel">
                    <!-- Weekly -->
                    <ul class="list-group">
                      <% let weeklyTotal=[]; %>
                        <% let currentTimestamp=today; let i=0; for (let
                          date=currentTimestamp; date>= rangeStart; date -= 1000 * 60 * 60 * 24) {
                          const dateString = new Date(date).toISOString().split('T')[0];

                          if (foodHistory[dateString]) {
                          weeklyTotal.push(foodHistory[dateString]);
                          }
                          //TODO: Should we count today on the weekly average?
                          else if(date === today && totalCalories >= calorieGoal()){
                          weeklyTotal.push({calories: totalCalories, protein: totalProtein, carbs: totalCarbs,
                          fat: totalFat});
                          }

                          if( i>0 && i % 7 === 0) {
                          //We take what we do have and average it
                          let total = weeklyTotal.length;
                          if(total == 0) continue;

                          const totals = weeklyTotal.reduce((sum, item) => {
                          sum.calories += item.calories ?? 0;
                          sum.protein += item.protein ?? 0;
                          sum.carbs += item.carbs ?? 0;
                          sum.fat += item.fat ?? 0;
                          return sum;
                          }, {
                          calories: 0,
                          protein: 0,
                          carbs: 0,
                          fat: 0
                          });
                          // console.log(totals.calories+" total calories consumed on "+total+" days");
                          const calories = totals.calories / total;
                          const protein = totals.protein / total;
                          const carbs = totals.carbs / total;
                          const fat = totals.fat / total;
                          weeklyTotal = [];


                          const msPerWeek = 1000 * 60 * 60 * 24 * 7;
                          const weeksAgo = Math.floor((today - date) / msPerWeek) - 1;

                          let weeksAgoStr = `${weeksAgo} weeks ago`
                          if (weeksAgo < 1) { weeksAgoStr="This Week" } else if(weeksAgo < 2) { weeksAgoStr="Last Week"
                            } %>
                            <li class="list-group-item">
                              <div class="d-flex justify-content-between">
                                <span>
                                  <%= weeksAgoStr %>
                                </span>
                                <strong
                                  class="text-<%= calories > calorieGoal()+calorieGoalTolerance ? 'danger' : 'success' %>">
                                  <%= Math.round(calories) %> avg kcal
                                </strong>
                              </div>
                              <div class="small text-muted">
                                <span class="text-nowrap">Protein: <strong>
                                    <%= Math.round(protein) %>g
                                  </strong></span>
                                • <span class="text-nowrap">Carbs: <strong>
                                    <%= Math.round(carbs) %>g
                                  </strong> </span>
                                • <span class="text-nowrap">Fat: <strong>
                                    <%= Math.round(fat) %>g
                                  </strong></span>
                              </div>
                            </li>
                            <% } i+=1; } %>
                    </ul>
                  </div>
                  <div class="tab-pane fade" id="profile" role="tabpanel">
                    <!-- Daily -->
                    <ul class="list-group">
                      <% for (let i=sortedDates.length - 1; i>= 0; i-=1) {
                        const date = sortedDates[i];
                        const totals = foodHistory[date];
                        const calories = totals?.calories ?? 0;
                        const protein = totals?.protein ?? 0;
                        const carbs = totals?.carbs ?? 0;
                        const fat = totals?.fat ?? 0;
                        const d = new Date(`${date}T00:00:00.000Z`);
                        const daysAgo = Math.round((today - d.getTime()) /
                        (1000*60*60*24));
                        %>
                        <li class="list-group-item">
                          <div class="d-flex justify-content-between">
                            <span>
                              <%= daysAgo === 0 ? "Today" : daysAgo === 1 ? "Yesterday" : `${daysAgo} days ago` %>
                            </span>
                            <strong
                              class="text-<%= calories > calorieGoal()+calorieGoalTolerance ? 'danger' : 'success' %>">
                              <%= Math.round(calories) %> kcal
                            </strong>
                          </div>
                          <div class="small text-muted">
                            Protein: <strong>
                              <%= Math.round(protein) %>g
                            </strong> • Carbs: <strong>
                              <%= Math.round(carbs) %>g
                            </strong> • Fat: <strong>
                              <%= Math.round(fat) %>g
                            </strong>
                          </div>
                        </li>
                        <% } %>
                    </ul>
                  </div>
                </div>



                <% } else { %>
                  <div class="text-muted text-center">
                    No history yet...
                  </div>
                  <% } %>
        </div>
      </div>



    </div>
